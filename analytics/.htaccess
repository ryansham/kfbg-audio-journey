# KFBG Audio Journey 數據簡報 —— 秘密連結 folder 的設定
#
# 位置：comm.kfbg.org/public_html/analytics-and-dashboards/<秘密 folder 名>/.htaccess
#       folder 名不寫在這裡（這個 repo 是公開的），見 kfbg-comm-hub README。
#
# 🔓 這個 folder 刻意放在 comm.kfbg.org 的密碼閘外面：知道網址就看得到，不用登入。
#    2026-09-25 Ryan 拍板，做法跟 70A 活動睇板一樣。保護只有一層：網址沒人知道。
#    所以 folder 名是隨機的，而且下面加了 noindex。
#
# ⚠️ DirectAdmin 的 File Manager 不會經 zip 解壓帶出點開頭的檔案。
#    用 File Manager 的「Create New File」手動建立 .htaccess，再貼上本檔內容。
#
# 上載後一定要跑：  analytics/test-live.sh
#    它由外面、不帶密碼打一次，確認開放的只有該開放的那幾個檔。

# ── 1. 對這個 folder 關掉父層的密碼閘 ───────────────────────────────────────
# 兩行都要：只寫 AuthType None 會 500；只寫 Require all granted 可以，但看不出意圖。
AuthType None
Require all granted

# ── 2. 憑證：父層已經擋，這裡再擋一次 ───────────────────────────────────────
# 本機 Apache 2.4.66 實測（2026-09-25）：
#   · 父層正常時，父層的 FilesMatch 已經擋住 config.php 和 token.json（403）。
#   · 但把父層那段拿走（模擬 live 與 repo drift —— 70A 那次真的發生過），
#     只靠上面兩行的話 cache/token.json 以 200 整份吐出：生效中的 GA access token
#     直接送上公網。加了這一段，同樣情況下仍然 403。
# 所以這段不是裝飾，是父層失守時唯一擋住憑證的東西。不要刪。
# .ht* 也放進來：同一個實驗裡 .htaccess 本身變成 200。live 伺服器的全域設定本來就擋
# .ht*，不過這裡不依賴一個在 repo 裡看不到、本機也驗不到的設定。
<FilesMatch "^(\.ht.*|config.*\.php|token\.json|.*key.*\.json|.*credential.*|.*service-account.*)$">
  Require all denied
</FilesMatch>

# ── 3. 開發和說明檔不公開 ─────────────────────────────────────────────────
# 父層只擋憑證，不擋這些。實測只寫第 1 段的話 README.md、build_data.py、
# test-proxy.php 都回 200。按「類別」擋而不是逐個列名：以後多一個測試或工具檔，
# 不會因為沒人記得加名字而靜靜地公開。
# 應該送出去的只有三個：index.html、ga-proxy.php、data.json。
<FilesMatch "^(test-.*|check\.py|.*\.(py|mjs|md|sh|orig|bak|txt)|\.DS_Store)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # ── 4. 不被收錄 ─────────────────────────────────────────────────────────
  # 秘密連結萬一被貼到搜尋器爬得到的地方，這條令它不會出現在搜尋結果。
  Header set X-Robots-Tag "noindex, nofollow, noarchive"

  # ── 5. 數字不被快取 ──────────────────────────────────────────────────────
  # data.json 每次更新都會變，頁面已經加了 cache-busting 參數，這是伺服器端的
  # 第二道保險。ga-proxy.php 自己會送 Cache-Control，這裡確保中介層不擅自快取。
  <FilesMatch "(\.json|^ga-proxy\.php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
