# KFBG Audio Journey — /analytics/ 目錄設定
# 位置：public_html/analytics/.htaccess
#
# ⚠️ DirectAdmin 的 File Manager 預設不顯示以點開頭的檔案。若上載後看不見，
#    請用 File Manager 的「Create File」手動建立，再貼上本檔內容。
#
# 每條指令都用 <IfModule> 包住 —— 模組不存在時應該安靜降級，不是 500 整站。

# ── 憑證與快取：絕不對外 ────────────────────────────────────────────────────
# 🔴 config.php 內有 service account 金鑰的路徑；cache/ 內有生效中的 GA access
#    token。PHP 正常運作時 config.php 不會輸出內容，但 PHP 一旦故障或被停用，
#    伺服器就會把它當純文字送出去。所以明文擋死，不倚賴 PHP 一定正常。
<FilesMatch "^(config\.php|config\.sample\.php|test-proxy\.php|build_data\.py)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 任何看起來像憑證的檔案，即使誤放進這個資料夾也打不開。
<FilesMatch "(key|credential|service-account)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  # data.json 每次更新數字都會改，而網站根目錄的 .htaccess 沒有為 .json 設任何
  # Cache-Control，瀏覽器會套用啟發式快取（可以長達數天）。頁面本身已經加了
  # cache-busting 參數，這條是伺服器端的第二道保險。
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ga-proxy.php 自己會送 Cache-Control，這裡確保沒有中介層擅自快取。
  <FilesMatch "^ga-proxy\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # 本頁不應被搜尋引擎收錄。HTML 內已有 <meta name="robots">，
  # 這條 header 連非 HTML 檔（例如直接開 data.json）都一併覆蓋。
  <FilesMatch "\.(html|json|php)$">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>

# ── 存取控制 ────────────────────────────────────────────────────────────────
# 建議用 DirectAdmin 介面設定，不要在這裡手寫 AuthUserFile：
#     DirectAdmin → Advanced Features → Password Protected Directories
#     → 選 public_html/analytics → 設定使用者名稱與密碼
# 介面會自動建立 .htpasswd 並填上正確的絕對路徑，省卻猜路徑出錯。
#
# 設定好之後，把 index.html 內的 REQUIRE_PASSWORD 改成 false，
# 訪客就只會被問一次密碼，不會先過瀏覽器彈窗、再過網頁密碼框。
